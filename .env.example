# Application Settings
PROJECT_NAME="DailyProblemBot"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration (PostgreSQL with asyncpg driver)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/daily_problem_bot"

# Telegram Bot API Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Daily Scheduler Configuration (24-hour format)
SCHEDULER_CRON_HOUR=8
SCHEDULER_CRON_MINUTE=0
APP_TIMEZONE="Asia/Kolkata"
